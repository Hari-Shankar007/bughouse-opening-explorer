# Existing hosted opening-index proxy. This backend forwards bounded requests to it.
OPENING_SERVICE_URL=https://bughouse.aronteh.com/api/opening-explorer
# Leave blank for the public hosted route; set only if your upstream requires a bearer token.
OPENING_SERVICE_TOKEN=

# Allow this origin for the GitHub Pages frontend (or use the local origin during development).
CATALOG_ALLOWED_ORIGINS=https://hari-shankar007.github.io,http://localhost:5173

# For local development, Vite sends API requests to this backend.
CATALOG_API_URL=http://127.0.0.1:8001

# Set only when using Games/Players endpoints; the raw crawler database is not included here.
BUGHOUSE_CRAWLER_DB=data/crawler.db

