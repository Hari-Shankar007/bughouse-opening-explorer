# Read-only, closed/checkpointed copy of the existing crawler SQLite database.
BUGHOUSE_CRAWLER_DB=../data/crawler.db

# Existing bounded opening reader. Both values stay server-side.
OPENING_SERVICE_URL=https://your-authorized-opening-service.example
OPENING_SERVICE_TOKEN=replace-with-server-secret

# Browser origin for local development; configure your deployed site origin in production.
CATALOG_ALLOWED_ORIGINS=http://localhost:5173
